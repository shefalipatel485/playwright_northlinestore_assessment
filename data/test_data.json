{
  "app": {
    "base_url": "https://ecomcicid.netlify.app",
    "products_path": "/products",
    "cart_path": "/cart",
    "checkout_path": "/checkout",
    "expected_title": "Northline Store"
  },
  "api": {
    "base_url": "https://681444af225ff1af16285b31.mockapi.io/electronicapi",
